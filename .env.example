# Copy to .env and fill in. Never commit .env.

TZ=America/Toronto
APP_PORT=8480
REFRESH_AT=05:30

# Set false only if you reach the app over plain http on the LAN.
COOKIE_SECURE=true

# Login for the app.
APP_USER=paul
# Password hash: the API image will ship a helper, expected to be
#   docker compose run --rm app python -m app.hash_password
# (not written yet)
APP_PASSWORD_HASH=
# Random 32+ bytes, for example: openssl rand -hex 32
SESSION_SECRET=
