# Copy to .env and fill in. Never commit .env.

TZ=America/Toronto
APP_PORT=8480

# Where the downloaded data lives. ./data is a folder next to docker-compose.yml, so it follows
# the project onto whichever volume you put it (volume1, volume3...). Visible in File Station.
DATA_PATH=./data
REFRESH_AT=05:30

# Set false if you open the app over plain http (for example http://nas:8480 on
# the LAN). Login cookies are refused over http while this is true.
COOKIE_SECURE=true

# Login for the app.
APP_USER=paul
# Password hash. Make it on any computer with Python 3 (nothing to install):
#   python3 app/hash_password.py
# or from the published image:
#   docker run --rm -it ghcr.io/thepaultanner/montreal-parking:latest python hash_password.py
# Paste the whole "scrypt:..." line below.
APP_PASSWORD_HASH=
# Random 32+ bytes, for example: openssl rand -hex 32
SESSION_SECRET=

# Container images built by GitHub Actions. Change only if you fork the repo.
# IMAGE=ghcr.io/thepaultanner/montreal-parking
# Pin a specific build (for example sha-1a2b3c4) instead of following latest.
# IMAGE_TAG=latest
