# Copy to .env and fill in. Never commit .env.

TZ=America/Toronto
APP_PORT=8480

# Where the downloaded data lives on the NAS (shows up in File Station, and
# Hyper Backup can include it).
DATA_PATH=/volume1/docker/montreal-parking/data
REFRESH_AT=05:30

# Set false if you open the app over plain http (for example http://nas:8480 on
# the LAN). Login cookies are refused over http while this is true.
COOKIE_SECURE=true

# Login for the app.
APP_USER=paul
# Password hash: the API image will ship a helper, expected to be
#   docker compose run --rm app python -m app.hash_password
# (not written yet)
APP_PASSWORD_HASH=
# Random 32+ bytes, for example: openssl rand -hex 32
SESSION_SECRET=
