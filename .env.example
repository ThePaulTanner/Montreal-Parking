# Copy to .env and fill in. Never commit .env.

TZ=America/Toronto
APP_PORT=8480

# Where the downloaded data lives. ./data is a folder next to docker-compose.yml, so it follows
# the project onto whichever volume you put it (volume1, volume3...). Visible in File Station.
DATA_PATH=./data
REFRESH_AT=05:30

# Keep true: Tailscale Serve gives real HTTPS. Set false only for a quick test over plain http.
COOKIE_SECURE=true

# Secret that protects stored passwords and authenticator keys. Random, 32+ characters, e.g.
#   openssl rand -hex 32
# Never change it after creating a login, or those logins stop working.
APP_SECRET=

# Sign out after this many minutes without use (HomeFinance uses 10; this app is not holding bank data).
SESSION_IDLE_MINUTES=480
# Failed sign-ins in a row before sign-in is locked for everyone until `cli.py unlock`.
MAX_FAILED_LOGINS=10

# Logins are created on the NAS after the app starts, not here:
#   sudo docker exec -it mtl-parking-app python cli.py create-user --username paul

# Container images built by GitHub Actions. Change only if you fork the repo.
# IMAGE=ghcr.io/thepaultanner/montreal-parking
# Pin a specific build (for example sha-1a2b3c4) instead of following latest.
# IMAGE_TAG=latest
